# IMPORTANTE: este arquivo é apenas um modelo. Nunca coloque chaves reais aqui.
# Para desenvolvimento local, copie para .env.local (já ignorado pelo Git).
# Para produção, use Vercel Environment Variables ou GitHub Actions Secrets.

# Obrigatório: connection string do Neon PostgreSQL.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require
# Alternativa aceita pelo app:
# NEON=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require

# Obrigatório: string aleatória longa (32+ caracteres).
SESSION_SECRET=gere-um-segredo-longo-e-aleatorio

# Chaves dos provedores de IA (somente no servidor; nunca use NEXT_PUBLIC_).
GROQ_API=coloque-a-chave-groq-aqui
GROQ2_API=coloque-a-chave-groq-secundaria-aqui
GEMINI_API=coloque-a-chave-gemini-aqui

# Modelos escolhidos para este projeto pessoal.
# Groq: rápido para conversas e suficientemente bom para uso geral.
GROQ_MODEL=llama-3.1-8b-instant
GROQ2_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-3.5-flash

# Classificação de idioma.
IDIOMAS_API=coloque-a-chave-da-api-de-idiomas-aqui
IDIOMAS_API_URL=https://api.nlpcloud.io/v1/python-langdetect/langdetection

# Geração de imagens.
# IMAGENS_API deve ser a chave/token do provedor.
# IMAGENS_API_URL deve ser um endpoint completo e válido; não use {id} literalmente.
IMAGENS_API=coloque-a-chave-da-api-de-imagens-aqui
IMAGENS_API_URL=https://api.exemplo.com/endpoint-de-geracao

# Opcional: endereço público do site para validações extras.
APP_URL=http://localhost:3000
