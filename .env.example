# Obrigatório: connection string do Neon PostgreSQL. Você também pode usar a variável NEON.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require
# NEON=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require

# Obrigatório: string aleatória longa (32+ caracteres). Ex.: gere com `openssl rand -base64 48`
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Chaves dos provedores de IA (somente no servidor; NÃO usar NEXT_PUBLIC_)
GROQ_API=
GROQ2_API=
GEMINI_API=

# Modelos opcionais. Verifique quais estão habilitados na sua conta.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ2_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-3.6-flash

# Classificador de idiomas que você já possui.
# IDIOMAS_API pode ser a CHAVE/token; informe a URL em IDIOMAS_API_URL.
# Também pode colocar a URL completa em IDIOMAS_API, deixando IDIOMAS_API_URL vazio.
IDIOMAS_API=
IDIOMAS_API_URL=

# API para gerar imagens. IMAGENS_API pode ser a CHAVE/token.
# Informe a URL do endpoint em IMAGENS_API_URL; também pode colocar a URL completa em IMAGENS_API.
IMAGENS_API=
IMAGENS_API_URL=

# Opcional: CORS não é aberto por padrão. Endereço público do site para validações extras.
APP_URL=http://localhost:3000
